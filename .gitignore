# === Data governance: NEVER commit patient-level data or licensed vocab ===
data/raw/
data/staging/
data/vocab/
*.csv
*.parquet
*.duckdb
*.db

# Allow small SYNTHETIC (PHI-free) test fixtures to be committed
!tests/fixtures/
!tests/fixtures/*.csv
!tests/fixtures/*.tsv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Neo4j / local stores
*.dump

# OS / editor
.DS_Store
.idea/
.vscode/
